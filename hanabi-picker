def _read(pj):
    """project.json como dict, ou None se faltar, for inválido ou não for um objeto."""
    try:
        with open(pj, encoding="utf-8-sig") as f:
            j = json.load(f)
    except (OSError, ValueError):
        return None
    return j if isinstance(j, dict) else None


def _str(v):
    return v.strip() if isinstance(v, str) else ""


def _kind(j):
    kind = _str(j.get("type")).lower()
    if not kind:  # projetos oficiais antigos não têm "type"
        kind = {".mp4": "video", ".webm": "video", ".json": "scene", ".html": "web"}.get(
            os.path.splitext(_str(j.get("file")))[1].lower(), "")
    return kind


def load_wallpapers():
    """Tudo que está instalado: Workshop inscrito + projetos do próprio Wallpaper Engine."""
    items = []
    sources = [(os.path.join(WORKSHOP, "*", "project.json"), "Workshop"),
               (os.path.join(PROJECTS, "defaultprojects", "*", "project.json"), "Oficial"),
               (os.path.join(PROJECTS, "myprojects", "*", "project.json"), "Meus projetos")]
    for pattern, source in sources:
        for pj in glob.glob(pattern):
            j = _read(pj)
            if not j:
                continue
            d = os.path.dirname(os.path.realpath(pj))
            src_dir, src = d, j
            preset = {}
            if not j.get("type") and j.get("dependency"):  # preset: o conteúdo está no item de que depende
                dep = os.path.join(WORKSHOP, str(j["dependency"]))
                dj = _read(os.path.join(dep, "project.json"))
                if not dj:
                    continue
                src_dir, src = os.path.realpath(dep), dj
                preset = j.get("preset") if isinstance(j.get("preset"), dict) else {}
            kind = _kind(src)
            if kind not in KIND_LABEL:
                continue
            video = os.path.join(src_dir, _str(src.get("file"))) if kind == "video" else None
            if video and not os.path.isfile(video):
                continue
            preview = os.path.join(d, _str(j.get("preview")))
            tags = j.get("tags") or src.get("tags")
            tags = [tags] if isinstance(tags, str) else tags
            items.append({
                "title": _str(j.get("title")) or os.path.basename(d),
                "kind": kind,
                "dir": src_dir,
                "video": video,
                "preview": preview if os.path.isfile(preview) else None,
                "desc": BBCODE.sub("", _str(j.get("description")) or _str(src.get("description"))).strip(),
                "tags": [str(t) for t in tags] if isinstance(tags, list) else [],
                "preset": preset,
                "source": source,
                "id": os.path.basename(d) if source == "Workshop" else None,
            })
    return sorted(items, key=lambda i: (i["kind"] != "video", i["title"].lower()))


def item_key(item):
    return (item["dir"], item["title"])


def preset_args(preset):
    """Propriedades de um preset no formato do --set-property do linux-wallpaperengine."""
    args = []
    for k, v in preset.items():
        if v is None or isinstance(v, (dict, list)):
            continue
        args += ["--set-property", f"{k}={str(v).lower() if isinstance(v, bool) else v}"]
    return args


def libcef_preload():
    """libcef.so para LD_PRELOAD: contorna o crash 'close symbol missing' dos wallpapers web
    (linux-wallpaperengine issue #628)."""
    exe = shutil.which("linux-wallpaperengine")
    candidates = ["/opt/linux-wallpaperengine/libcef.so"]
    if exe:
        candidates.insert(0, os.path.join(os.path.dirname(os.path.realpath(exe)), "libcef.so"))
    return next((c for c in candidates if os.path.isfile(c)), None)


def read_bg_config():
    """Wallpaper scene/web ativo na extensão Wallpaper Engine Background, ou None."""
    try:
        with open(BG_CONFIG, encoding="utf-8") as f:
            cfg = json.load(f)
    except (OSError, ValueError):
        return None
    return cfg if isinstance(cfg, dict) and isinstance(cfg.get("dir"), str) and cfg["dir"] else None


def write_bg_config(cfg):
    """Grava atomicamente (a extensão vigia o arquivo); None desliga o fundo scene/web."""
    os.makedirs(os.path.dirname(BG_CONFIG), exist_ok=True)
    tmp = BG_CONFIG + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(cfg or {}, f, ensure_ascii=False)
    os.replace(tmp, BG_CONFIG)


def extension_state(uuid):
    """Estado da extensão no GNOME Shell ('ACTIVE', 'ERROR', ...) ou None se não estiver instalada."""
    try:
        out = subprocess.run(["gnome-extensions", "info", uuid], capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    m = re.search(r"State:\s*(\S+)", out)
    return m.group(1) if m else None


def set_extension(uuid, enabled):
    try:
        subprocess.run(["gnome-extensions", "enable" if enabled else "disable", uuid], capture_output=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        pass


THUMBS = os.path.join(GLib.get_user_cache_dir(), "hanabi-wallpapers")
THUMBER = concurrent.futures.ThreadPoolExecutor(max_workers=4)


def thumb_paths(item):
    """(origem, miniatura em cache) para vídeos e GIFs, cujo 1º frame costuma ser preto (fade-in)."""
    prev = item["preview"] or ""
    src = item["video"] or (prev if prev.endswith((".gif", ".mp4")) else None)
    if not src:
        return None, None
    try:
        key = hashlib.sha1(f"{src}:{os.path.getmtime(src)}".encode()).hexdigest()
    except OSError:  # a Steam apagou o item enquanto o app estava aberto
        return None, None
    return src, os.path.join(THUMBS, key + ".jpg")


def make_thumb(src, dst):
    """Extrai um frame de ~40% da duração com ffmpeg. Roda numa thread; devolve dst ou None."""
    tmp = None
    try:
        dur = subprocess.run(["ffprobe", "-v", "error", "-show_entries", "format=duration", "-of", "csv=p=0", src],
                             capture_output=True, text=True, timeout=20).stdout.strip()
        seek = float(dur) * 0.4 if dur not in ("", "N/A") else 0.0
        os.makedirs(THUMBS, exist_ok=True)
        fd, tmp = tempfile.mkstemp(suffix=".jpg", dir=THUMBS)
        os.close(fd)
        subprocess.run(["ffmpeg", "-v", "error", "-y", "-ss", f"{seek:.2f}", "-i", src, "-frames:v", "1",
                        "-vf", "scale=480:-2", "-q:v", "4", tmp], capture_output=True, timeout=60)
        if os.path.getsize(tmp) > 0:
            os.replace(tmp, dst)
            return dst
    except (OSError, ValueError, subprocess.SubprocessError):
        pass
    if tmp and os.path.exists(tmp):
        os.remove(tmp)
    return None


def prune_thumbs(keep):
    """Apaga miniaturas de wallpapers que não existem mais. Roda numa thread."""
    for f in glob.glob(os.path.join(THUMBS, "*.jpg")):
        if os.path.basename(f) not in keep:
            try:
                os.remove(f)
            except OSError:
                pass


# GtkMediaFile finalizado logo depois de criado derruba o GStreamer (segfault em gstplay).
# Os players descartados ficam vivos (pausados) por alguns segundos antes de serem soltos.
RETIRED = []


def retire(media):
    media.pause()
    RETIRED.append(media)
    GLib.timeout_add_seconds(5, lambda: (RETIRED.remove(media), GLib.SOURCE_REMOVE)[1])


def static_image(item):
    prev = item["preview"] or ""
    return item.get("thumb") or (prev if prev and not prev.endswith(".mp4") else None)


class AnimPic(Gtk.Picture):
    """Picture que mostra a miniatura parada ou anima (vídeo pelo GStreamer, GIF pelo GdkPixbuf)."""

    def __init__(self, **kw):
        super().__init__(content_fit=Gtk.ContentFit.COVER, can_shrink=True, **kw)
        self.gen = 0
        self.media = None

    def show(self, item, animate=False, light=False):
        """light: prefere o GIF de preview (baixa resolução) ao vídeo original, que pode ser 4K."""
        self.gen += 1
        if self.media:
            retire(self.media)
            self.media = None
        img = static_image(item) if item else None
        if img:
            self.set_filename(img)
        else:
            self.set_paintable(None)
        if not animate or not item:
            return
        prev = item["preview"] or ""
        if (item["video"] and not (light and prev.endswith(".gif"))) or prev.endswith(".mp4"):
            self.media = Gtk.MediaFile.new_for_filename(item["video"] or prev)
            self.media.set_muted(True)
            self.media.set_loop(True)
            self.media.play()
            self.set_paintable(self.media)
        elif prev.endswith(".gif"):
            Gio.File.new_for_path(prev).read_async(GLib.PRIORITY_DEFAULT, None, self._gif_stream, self.gen)

    def set_playing(self, playing):
        if self.media:
            self.media.play() if playing else self.media.pause()

    def _gif_stream(self, f, res, gen):
        try:
            GdkPixbuf.PixbufAnimation.new_from_stream_async(f.read_finish(res), None, self._gif_ready, gen)
        except GLib.Error:
            pass

    def _gif_ready(self, _src, res, gen):
        try:
            anim = GdkPixbuf.PixbufAnimation.new_from_stream_finish(res)
        except GLib.Error:
            return
        if gen == self.gen and not anim.is_static_image():
            self._gif_step(anim.get_iter(None), gen, {})

    def _gif_step(self, it, gen, textures):
        if gen != self.gen:
            return GLib.SOURCE_REMOVE
        # o GIF devolve os mesmos pixbufs a cada volta: converte cada quadro em textura uma vez só
        pb = it.get_pixbuf()
        if pb not in textures:
            textures[pb] = Gdk.Texture.new_for_pixbuf(pb)
        self.set_paintable(textures[pb])
        delay = it.get_delay_time()
        it.advance(None)
        if delay > 0:
            GLib.timeout_add(max(delay, 20), self._gif_step, it, gen, textures)
        return GLib.SOURCE_REMOVE


GLOWS = {}


def glow_texture(rgb):
    """Sprite de brilho radial (miolo branco, borda na cor), gerado uma vez por cor."""
    if rgb not in GLOWS:
        size = 64
        surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, size, size)
        cr = cairo.Context(surf)
        g = cairo.RadialGradient(size / 2, size / 2, 0, size / 2, size / 2, size / 2)
        g.add_color_stop_rgba(0, 1, 1, 1, 1)
        g.add_color_stop_rgba(0.25, *rgb, 0.8)
        g.add_color_stop_rgba(1, *rgb, 0)
        cr.set_source(g)
        cr.paint()
        surf.flush()
        GLOWS[rgb] = Gdk.MemoryTexture.new(size, size, Gdk.MemoryFormat.B8G8R8A8_PREMULTIPLIED,
                                           GLib.Bytes.new(bytes(surf.get_data())), surf.get_stride())
    return GLOWS[rgb]


class Particles(Gtk.Widget):
    """Camada de partículas: brasas ambiente atrás, explosões na frente."""

    def __init__(self, ambient):
        super().__init__(can_target=False, hexpand=True, vexpand=True)
        self.ambient = ambient
        self.parts, self.rings, self.flash = [], [], 0.0
        self.last = None
        self.drawn = 0.0
        self.accent = (0.6, 0.4, 1.0)
        self.add_tick_callback(self.tick)

    def spawn_ember(self, w, h, anywhere=False):
        c = random.choice([self.accent, (0.3, 0.9, 1.0), (1.0, 0.45, 0.75)])
        self.parts.append(dict(x=random.uniform(0, w), y=random.uniform(0, h) if anywhere else h + 10,
                               vx=random.uniform(-8, 8), vy=random.uniform(-38, -12), r=random.uniform(1.2, 3.6),
                               life=random.uniform(6, 14), age=0.0, ph=random.uniform(0, 6.3), c=c, g=0.0))

    def burst(self, x, y, color):
        self.rings.append(dict(x=x, y=y, age=0.0, c=color))
        self.rings.append(dict(x=x, y=y, age=-0.12, c=(1, 1, 1)))
        self.flash = 0.35
        for _ in range(110):
            a, s = random.uniform(0, math.tau), random.uniform(120, 760)
            c = color if random.random() < 0.7 else (1, 1, 1)
            self.parts.append(dict(x=x, y=y, vx=math.cos(a) * s, vy=math.sin(a) * s, r=random.uniform(1.2, 3.2),
                                   life=random.uniform(0.5, 1.4), age=0.0, ph=0.0, c=c, g=900.0))

    def tick(self, _w, clock):
        now = clock.get_frame_time() / 1e6
        dt = min(now - self.last, 0.05) if self.last else 0.016
        self.last = now
        root = self.get_root()
        if self.ambient and root and not root.is_active():  # janela sem foco: brasas congeladas, sem CPU
            return GLib.SOURCE_CONTINUE
        w, h = self.get_width(), self.get_height()
        if self.ambient and w > 0:
            first = not self.parts
            while len(self.parts) < min(int(w * h / 14000), MAX_EMBERS):
                self.spawn_ember(w, h, anywhere=first)
        for p in self.parts:
            p["age"] += dt
            if p["g"]:
                p["vx"] *= 1 - 1.6 * dt
            p["vy"] += p["g"] * dt
            p["x"] += (p["vx"] + (0 if p["g"] else math.sin(p["age"] * 1.3 + p["ph"]) * 14)) * dt
            p["y"] += p["vy"] * dt
        self.parts = [p for p in self.parts if p["age"] < p["life"] and p["y"] > -20]
        for r in self.rings:
            r["age"] += dt
        self.rings = [r for r in self.rings if r["age"] < 0.9]
        self.flash = max(0.0, self.flash - dt * 1.4)
        # brasas lentas a ~24 fps: cada redesenho repinta a janela inteira; explosões continuam a 60 fps
        if self.rings or self.flash or (self.parts and (not self.ambient or now - self.drawn >= 1 / 24)):
            self.drawn = now
            self.queue_draw()
        return GLib.SOURCE_CONTINUE

    def do_snapshot(self, s):
        # cada partícula é uma textura de brilho pronta, desenhada pela GPU (cairo em tela cheia custava ~17% de CPU)
        for p in self.parts:
            t = p["age"] / p["life"]
            a = ((1 - t) ** 1.5 if p["g"] else
                 math.sin(min(t, 1) * math.pi) * (0.55 + 0.45 * math.sin(p["age"] * 4 + p["ph"])))
            if a <= 0.01:
                continue
            r = p["r"] * (3 if p["g"] else 4)
            s.push_opacity(min(a, 1.0))
            s.append_texture(glow_texture(p["c"]), Graphene.Rect().init(p["x"] - r, p["y"] - r, 2 * r, 2 * r))
            s.pop()
        if self.rings or self.flash:
            self.draw_burst(s.append_cairo(Graphene.Rect().init(0, 0, self.get_width(), self.get_height())))

    def draw_burst(self, cr):
        for ring in self.rings:
            t = ring["age"] / 0.9
            if t < 0:
                continue
            cr.set_source_rgba(*ring["c"], (1 - t) * 0.9)
            cr.set_line_width(14 * (1 - t) + 1)
            cr.arc(ring["x"], ring["y"], 20 + (1 - (1 - t) ** 3) * 340, 0, math.tau)
            cr.stroke()
        if self.flash:
            cr.set_source_rgba(*self.accent, self.flash * 0.35)
            cr.paint()


class Card(Gtk.Widget):
