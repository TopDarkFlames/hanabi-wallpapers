        self.h = self.hg = 0.0
        self.mx = self.my = 0.0
        self.intro = 0.0
        self.intro_pending = False
        self.intro_from = None
        self.tick_gen = 0
        self.loaded = False
        self.hover_id = 0
        self.flat = None  # renderer cairo não suporta perspectiva 3D

