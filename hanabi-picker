            lbl = Gtk.Label(label=t)
            lbl.add_css_class("tag")
            self.tags.append(lbl)
        self.desc.set_label(item["desc"] or "Sem descrição.")
        self.apply.set_label("APLICAR NO FUNDO")
        self.note.set_label("Roda no fundo pela extensão Wallpaper Engine Background (linux-wallpaperengine). "
                            "Alguns efeitos podem não funcionar." + (" Wallpapers Web são experimentais."
                                                                     if item["kind"] == "web" else ""))
        self.note.set_visible(item["kind"] != "video")
        self.preview_btn.set_visible(item["kind"] != "video")
        self.workshop.set_sensitive(bool(item["id"]))


class Picker(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Hanabi Wallpapers", default_width=1180, default_height=860)
        self.add_css_class("picker")
        self.settings = Gio.Settings.new(SCHEMA)
        self.cards = []
        self.selected = None
        self.query, self.kind = "", "all"
        self.preview_proc = None
        acc = Adw.StyleManager.get_default().get_accent_color_rgba()
        self.accent = (acc.red, acc.green, acc.blue)

        root = Gtk.Overlay()
        self.backdrop = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE, transition_duration=1100)
        root.set_child(self.backdrop)
        veil = Gtk.Box()
        veil.add_css_class("veil")
        root.add_overlay(veil)
        self.embers = Particles(ambient=True)
        self.embers.accent = self.accent
        root.add_overlay(self.embers)

        header = Adw.HeaderBar(show_title=False)
        header.add_css_class("top")
        brand = Gtk.Label(label="WALLPAPERS")
        brand.add_css_class("brand")
        header.pack_start(brand)
        tabs = Gtk.Box()
        self.tabs = {}
        group = None
        for key in ["all", *KIND_LABEL]:
            b = Gtk.ToggleButton(active=key == "all", group=group)
            group = group or b
            b.add_css_class("tab")
            b.connect("toggled", self.on_tab, key)
            tabs.append(b)
            self.tabs[key] = b
        header.pack_start(tabs)
        search = Gtk.SearchEntry(placeholder_text="Buscar…", width_request=200, valign=Gtk.Align.CENTER)
        search.add_css_class("search")
        search.connect("search-changed", self.on_search)
        header.pack_end(search)
        default = Gtk.Button(label="Padrão", tooltip_text="Sem wallpaper animado: volta ao fundo normal do GNOME",
                             valign=Gtk.Align.CENTER)
        default.connect("clicked", lambda _b: self.restore_default())
        header.pack_end(default)

        self.flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, homogeneous=True,
                                column_spacing=12, row_spacing=12, max_children_per_line=20,
                                margin_start=16, margin_end=16, margin_bottom=20, margin_top=14,
                                valign=Gtk.Align.START)
        self.flow.set_filter_func(self.filter)
        self.grid = Gtk.ScrolledWindow(hexpand=True, vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER,
                                       child=self.flow)
        empty = Adw.StatusPage(icon_name="preferences-desktop-wallpaper-symbolic", title="Nenhum wallpaper encontrado",
                               description=f"Instale o Wallpaper Engine pela Steam e assine wallpapers no Workshop.\n"
                                           f"Procurando em {STEAM}")
        self.grid_stack = Gtk.Stack(hexpand=True)
        self.grid_stack.add_named(self.grid, "grid")
        self.grid_stack.add_named(empty, "empty")
        self.panel = Panel(self)
        body = Gtk.Box()
        body.append(self.grid_stack)
        body.append(self.panel)
        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        content.append(header)
        content.append(body)
        self.toasts = Adw.ToastOverlay(child=content)
        root.add_overlay(self.toasts)
        self.fx = Particles(ambient=False)
        root.add_overlay(self.fx)
        self.set_content(root)

        self.connect("close-request", lambda *_: self.kill_preview())
        self.connect("notify::is-active", lambda w, _p: self.panel.preview.set_playing(w.is_active()))
        for key in ("mute", "volume"):
            self.settings.connect(f"changed::{key}", self.on_volume_changed)
        self.populate()
        # Steam baixa inscrições novas (e apaga as canceladas) nessas pastas: recarrega sozinho
        self.reload_id = 0
        self.monitors = []
        for d in (WORKSHOP, os.path.join(PROJECTS, "myprojects")):
            if os.path.isdir(d):
                m = Gio.File.new_for_path(d).monitor_directory(Gio.FileMonitorFlags.WATCH_MOVES, None)
                m.connect("changed", self.on_library_changed)
                self.monitors.append(m)

    def populate(self):
        """(Re)monta a grade. Mantém o wallpaper selecionado e a rolagem; devolve as chaves carregadas."""
        items = load_wallpapers()
        counts = collections.Counter(i["kind"] for i in items)
        self.tabs["all"].set_label(f"INSTALADOS  {len(items)}")
        for k in KIND_LABEL:
            self.tabs[k].set_label(f"{KIND_LABEL[k]}  {counts[k]}")
        prev_sel = item_key(self.selected.item) if self.selected else None
        scroll = self.grid.get_vadjustment().get_value()
        self.flow.remove_all()
        self.cards, self.selected = [], None
        hanabi_on = extension_state(HANABI_EXT) == "ACTIVE"
        current = os.path.realpath(self.settings.get_string("video-path") or "/")
        bg = read_bg_config()
        active = keep = None
        for item in items:
            card = Card(item)
            click = Gtk.GestureClick()
            click.connect("released", self.on_click, card)
            card.add_controller(click)
            self.cards.append(card)
            self.flow.append(card)
            if active:
                pass
            elif bg:
                if item["dir"] == bg["dir"] and item["preset"] == bg.get("preset", {}):
                    active = card
            elif hanabi_on and item["video"] and os.path.realpath(item["video"]) == current:
                active = card
            if prev_sel and item_key(item) == prev_sel:
                keep = card
        self.grid_stack.set_visible_child_name("grid" if items else "empty")
        self.mark_active(active)
        self.select(keep or active or (self.cards[0] if self.cards else None))
        GLib.idle_add(lambda: (self.grid.get_vadjustment().set_value(scroll), GLib.SOURCE_REMOVE)[1])
        GLib.idle_add(self.intro)
        keep_thumbs = {os.path.basename(p) for p in (thumb_paths(i)[1] for i in items) if p}
        THUMBER.submit(prune_thumbs, keep_thumbs)
        return {item_key(i) for i in items}

    def on_library_changed(self, *_):
        if self.reload_id:
            GLib.source_remove(self.reload_id)
        self.reload_id = GLib.timeout_add_seconds(3, self._reload)  # espera o download terminar de mover

    def _reload(self):
        self.reload_id = 0
        before = {item_key(c.item) for c in self.cards}
        after = self.populate()
        added, removed = len(after - before), len(before - after)
        parts = [f"{added} novo(s)"] * bool(added) + [f"{removed} removido(s)"] * bool(removed)
        if parts:
            self.toasts.add_toast(Adw.Toast(title=f"Wallpapers da Steam: {', '.join(parts)}", timeout=3))
        return GLib.SOURCE_REMOVE

    def intro(self, replay=True):
        """Entrada em cascata. replay=False só anima cards que acabaram de aparecer (ainda invisíveis)."""
        visible = [c for c in self.cards if self.filter(c.get_parent())]
        if replay:
            for c in visible:
                c.intro = 0.0
                c.queue_draw()
        pending = [c for c in visible if c.intro == 0 and not c.intro_pending]
        for i, c in enumerate(pending):
            c.intro_pending = True
            GLib.timeout_add(min(i * 18, 1200), self._intro_card, c)
        return GLib.SOURCE_REMOVE

    def _intro_card(self, c):
        c.intro_pending = False
        c.load_thumb()
        c.start_intro()
        return GLib.SOURCE_REMOVE

    def filter(self, child):
        item = child.get_child().item
        return self.kind in ("all", item["kind"]) and self.query in item["title"].lower()

    def on_search(self, entry):
        self.query = entry.get_text().lower()
        self.flow.invalidate_filter()
        self.intro(replay=False)

    def on_tab(self, button, key):
        if button.get_active():
            self.kind = key
            self.flow.invalidate_filter()
            self.intro()

    def set_backdrop(self, item):
        # imagem minúscula ampliada = desfoque calculado uma vez só; filter: blur() em tela cheia era
        # refeito a cada quadro (as animações de CSS redesenham a janela) e custava ~25% de CPU
        pic = Gtk.Picture(content_fit=Gtk.ContentFit.COVER, can_shrink=True)
        pic.add_css_class("backdrop")
        img = static_image(item)
        if img:
            try:
                pic.set_paintable(Gdk.Texture.new_for_pixbuf(GdkPixbuf.Pixbuf.new_from_file_at_scale(img, 40, -1, True)))
            except GLib.Error:
                pass
        old = self.backdrop.get_visible_child()
        self.backdrop.add_child(pic)
        self.backdrop.set_visible_child(pic)
        if old:
            GLib.timeout_add(1300, lambda: (self.backdrop.remove(old), GLib.SOURCE_REMOVE)[1])

    def mark_active(self, card):
        for c in self.cards:
            c.set_flag("active", c is card)
        if card:
            card.load_thumb()
            self.set_backdrop(card.item)

    def select(self, card):
        if self.selected:
            self.selected.set_flag("selected", False)
        self.selected = card
        if card:
            card.set_flag("selected", True)
        self.panel.show_item(card.item if card else None)

    def burst_at(self, widget, x, y, item):
        ok, pt = widget.compute_point(self.fx, Graphene.Point().init(x, y))
        if ok:
            self.fx.burst(pt.x, pt.y, self.accent if item["kind"] == "video" else KIND_COLOR[item["kind"]])

    def on_click(self, _g, _n, x, y, card):
        self.burst_at(card, x, y, card.item)
        self.select(card)
        self.activate_item(card.item, None)  # como no Wallpaper Engine: clicar já aplica

    def bg_volume(self):
        return 0 if self.settings.get_boolean("mute") else self.settings.get_int("volume")

    def on_volume_changed(self, *_):
        cfg = read_bg_config()
        if cfg and cfg.get("volume") != self.bg_volume():
            write_bg_config({**cfg, "volume": self.bg_volume()})  # a extensão reinicia o wallpaper com o som novo

    def activate_item(self, item, button):
        if button:
            self.burst_at(button, button.get_width() / 2, button.get_height() / 2, item)
        card = next((c for c in self.cards if item_key(c.item) == item_key(item)), None)
        if not card or not os.path.isdir(item["dir"]) or (item["video"] and not os.path.isfile(item["video"])):
            self.toasts.add_toast(Adw.Toast(title="Esse wallpaper não está mais instalado", timeout=3))
            return
        if item["kind"] == "video":
            # vídeo vai pelo Hanabi: desliga o fundo scene/web e religa o Hanabi
            if read_bg_config():
                write_bg_config(None)
            if extension_state(HANABI_EXT) not in ("ACTIVE", None):
                set_extension(HANABI_EXT, True)
            self.settings.set_string("video-path", item["video"])
            msg = f"Aplicado: {item['title']}"
        else:
            state = extension_state(BG_EXT)
            if state is None:
                self.toasts.add_toast(Adw.Toast(
                    title="Falta a extensão Wallpaper Engine Background: rode o install.sh e saia e entre na sessão",
                    timeout=5))
                return
            write_bg_config({"dir": item["dir"], "kind": item["kind"], "preset": item["preset"],
                             "title": item["title"], "volume": self.bg_volume(), "fps": 30})
            set_extension(HANABI_EXT, False)  # o vídeo do Hanabi ficaria por baixo, gastando GPU à toa
            if state != "ACTIVE":
                set_extension(BG_EXT, True)
            msg = (f"Aplicado: {item['title']}" if state == "ACTIVE" else
                   "Extensão Wallpaper Engine Background ativada: saia e entre na sessão para o fundo aparecer")
        self.mark_active(card)
        self.toasts.add_toast(Adw.Toast(title=msg, timeout=3))

    def restore_default(self):
        write_bg_config(None)
        set_extension(HANABI_EXT, False)
        self.mark_active(None)
        self.toasts.add_toast(Adw.Toast(title="Fundo padrão do GNOME restaurado", timeout=3))

    def kill_preview(self):
        """Fecha o preview e os processos filhos (os wallpapers web abrem vários processos do navegador
        embutido, que ignoram SIGTERM)."""
        proc, self.preview_proc = self.preview_proc, None
        if proc and proc.poll() is None:
            for sig in (signal.SIGTERM, signal.SIGKILL):
                try:
                    os.killpg(proc.pid, sig)
                    proc.wait(1.5)
                    break
                except subprocess.TimeoutExpired:
                    continue
                except ProcessLookupError:
                    break
            try:
                os.killpg(proc.pid, signal.SIGKILL)  # filhos que sobraram depois que o principal saiu
            except ProcessLookupError:
                pass
            proc.poll()
        return False

    def open_preview(self, item):
        self.kill_preview()
        env = dict(os.environ)
        cef = libcef_preload() if item["kind"] == "web" else None
        if cef:
            env["LD_PRELOAD"] = " ".join(filter(None, [cef, env.get("LD_PRELOAD")]))
        cmd = ["linux-wallpaperengine", "--silent", "--window", "120x80x1280x720",
               *preset_args(item["preset"]), item["dir"]]
        try:
            proc = subprocess.Popen(cmd, env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                    start_new_session=True)  # grupo próprio, para fechar tudo junto
        except OSError as e:
            self.toasts.add_toast(Adw.Toast(title=f"Não consegui abrir o preview: {e}", timeout=4))
            return
        self.preview_proc = proc
        self.toasts.add_toast(Adw.Toast(title=f"Abrindo preview ao vivo: {item['title']}", timeout=2))
        started = GLib.get_monotonic_time()

        def watch():
            rc = proc.poll()  # também recolhe o processo quando a janela de preview é fechada
            if rc is None:
                return GLib.SOURCE_CONTINUE
            if rc != 0 and GLib.get_monotonic_time() - started < 10_000_000 and proc is self.preview_proc:
                self.toasts.add_toast(Adw.Toast(
                    title=f"O linux-wallpaperengine não conseguiu abrir “{item['title']}” (código {rc}). "
                          "Esse wallpaper usa algo que ele ainda não suporta.", timeout=5))
            return GLib.SOURCE_REMOVE

        GLib.timeout_add(500, watch)


def main():
    if "--list" in sys.argv:
        items = load_wallpapers()
        if not items:
            print(f"Nenhum wallpaper encontrado em {STEAM}", file=sys.stderr)
            return 1
        missing = [i["title"] for i in items if i["kind"] == "video" and not os.path.isfile(i["video"])]
        if missing:
            print(f"Vídeos sumiram: {missing}", file=sys.stderr)
            return 1
        print(collections.Counter(i["kind"] for i in items), "sem preview:", sum(not i["preview"] for i in items))
        return 0
    app = Adw.Application(application_id=APP_ID)

    def startup(a):
        css = Gtk.CssProvider()
        css.load_from_string(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), css,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK)

    app.connect("startup", startup)
    app.connect("activate", lambda a: (a.get_active_window() or Picker(a)).present())
    return app.run([])


if __name__ == "__main__":
    sys.exit(main())
