    def light_anim(self):
        return bool(self.item and (self.item["preview"] or "").endswith(".gif"))

    def show_item(self, item):
        self.item = item
        self.details.set_sensitive(item is not None)
        self.preview.show(item, animate=self.light_anim(), light=True)
        if not item:
            self.title.set_label("Nenhum wallpaper")
            self.kind.set_visible(False)
            self.meta.set_label("")
            self.tags.remove_all()
            self.desc.set_label("")
            self.apply.set_label("APLICAR NO FUNDO")
